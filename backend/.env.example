PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/skilltrack
JWT_SECRET=
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# AI & External Data APIs (Server-Side Secrets ONLY)
GEMINI_API_KEY=
YOUTUBE_API_KEY=

# Seed Admin Credentials
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Google OAuth Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Transactional Email / SMTP Provider Credentials (Sender Account)
# Recipient addresses are dynamically resolved per user (e.g. user.email)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=SkillTrack AI <no-reply@skilltrack.gov.in>
RESEND_API_KEY=

# Redis Queue Configuration
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=